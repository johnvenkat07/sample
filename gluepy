import sys
from awsglue.transforms import *
from awsglue.utils import getResolvedOptions
from pyspark.context import SparkContext
from awsglue.context import GlueContext
from awsglue.job import Job
from pyspark.sql.functions import col, current_timestamp
from awsglue.dynamicframe import DynamicFrame

# Get parameters
args = getResolvedOptions(sys.argv, ['JOB_NAME', 'connection_name'])

# Initialize Glue
sc = SparkContext()
glueContext = GlueContext(sc)
spark = glueContext.spark_session
job = Job(glueContext)
job.init(args['JOB_NAME'], args)

print("=" * 50)
print("Employee CRUD Operations")
print("=" * 50)

# ==================== CREATE ====================
def create_employee():
    """Insert a new employee"""
    
    # Employee data
    employee = {
        "employee_id": 1001,
        "first_name": "John",
        "last_name": "Doe",
        "email": "john.doe@company.com",
        "department": "Engineering",
        "salary": 75000.00,
        "hire_date": "2024-01-15"
    }
    
    # Create DataFrame
    df = spark.createDataFrame([employee])
    df = df.withColumn("created_at", current_timestamp())
    
    # Convert to DynamicFrame
    dynamic_frame = DynamicFrame.fromDF(df, glueContext, "new_employee")
    
    # Write to database
    glueContext.write_dynamic_frame.from_options(
        frame=dynamic_frame,
        connection_type="jdbc",
        connection_options={
            "useConnectionProperties": "true",
            "dbtable": "public.employees",
            "connectionName": args['connection_name']
        }
    )
    
    print(f"✓ Created employee: {employee['first_name']} {employee['last_name']}")


# ==================== READ ====================
def read_employee(employee_id):
    """Read a single employee by ID"""
    
    query = f"SELECT * FROM public.employees WHERE employee_id = {employee_id}"
    
    # Read from database
    dynamic_frame = glueContext.create_dynamic_frame.from_options(
        connection_type="jdbc",
        connection_options={
            "useConnectionProperties": "true",
            "query": query,
            "connectionName": args['connection_name']
        }
    )
    
    df = dynamic_frame.toDF()
    
    if df.count() > 0:
        print(f"✓ Found employee with ID {employee_id}")
        df.show()
    else:
        print(f"✗ No employee found with ID {employee_id}")
    
    return df


# ==================== UPDATE ====================
def update_employee(employee_id, new_salary):
    """Update employee salary"""
    
    # Read all employees
    dynamic_frame = glueContext.create_dynamic_frame.from_options(
        connection_type="jdbc",
        connection_options={
            "useConnectionProperties": "true",
            "dbtable": "public.employees",
            "connectionName": args['connection_name']
        }
    )
    
    df = dynamic_frame.toDF()
    
    # Update salary for the specific employee
    from pyspark.sql.functions import when
    
    updated_df = df.withColumn(
        "salary",
        when(col("employee_id") == employee_id, new_salary).otherwise(col("salary"))
    ).withColumn(
        "updated_at",
        when(col("employee_id") == employee_id, current_timestamp()).otherwise(col("updated_at"))
    )
    
    # Convert back to DynamicFrame
    updated_dynamic = DynamicFrame.fromDF(updated_df, glueContext, "updated")
    
    # Write back to database
    glueContext.write_dynamic_frame.from_options(
        frame=updated_dynamic,
        connection_type="jdbc",
        connection_options={
            "useConnectionProperties": "true",
            "dbtable": "public.employees",
            "connectionName": args['connection_name']
        }
    )
    
    print(f"✓ Updated employee {employee_id} salary to ${new_salary}")


# ==================== DELETE ====================
def delete_employee(employee_id):
    """Delete an employee by ID"""
    
    # Read all employees
    dynamic_frame = glueContext.create_dynamic_frame.from_options(
        connection_type="jdbc",
        connection_options={
            "useConnectionProperties": "true",
            "dbtable": "public.employees",
            "connectionName": args['connection_name']
        }
    )
    
    df = dynamic_frame.toDF()
    
    # Filter out the employee to delete
    filtered_df = df.filter(col("employee_id") != employee_id)
    
    # Convert to DynamicFrame
    filtered_dynamic = DynamicFrame.fromDF(filtered_df, glueContext, "filtered")
    
    # Write back to database
    glueContext.write_dynamic_frame.from_options(
        frame=filtered_dynamic,
        connection_type="jdbc",
        connection_options={
            "useConnectionProperties": "true",
            "dbtable": "public.employees",
            "connectionName": args['connection_name']
        }
    )
    
    print(f"✓ Deleted employee with ID {employee_id}")


# ==================== MAIN EXECUTION ====================

# Create a new employee
create_employee()

# Read the employee
read_employee(1001)

# Update the employee's salary
update_employee(1001, 80000.00)

# Read again to verify update
read_employee(1001)

# Delete the employee
# delete_employee(1001)

job.commit()